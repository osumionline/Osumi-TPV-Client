{
  "name": "osumi-tpv-client",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run typecheck:electron && node scripts/build-electron.mjs",
    "start:desktop": "npm run build:electron && concurrently -k -n ANGULAR,ELECTRON \"npm run start\" \"wait-on http://localhost:4200 && cross-env OSUMI_TPV_RENDERER_URL=http://localhost:4200 electron .\"",
    "start:desktop:prod": "npm run build:desktop && electron .",
    "build": "ng build",
    "build:desktop": "npm run build -- --base-href ./ && npm run build:electron",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:electron": "node scripts/test-electron.mjs",
    "test:electron:vitest": "vitest run --config electron/vitest.config.ts",
    "lint": "ng lint",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@osumi/angular-tools": "^1.5.2",
    "@osumi/ticketbaiws": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "nodemailer": "^9.0.5",
    "qrcode-generator": "^2.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/yauzl": "^3.4.0",
    "angular-eslint": "22.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
