{
  "name": "osumi-tpv-client",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run typecheck:electron && node scripts/build-electron.mjs",
    "start:desktop": "npm run build:electron && concurrently -k -n ANGULAR,ELECTRON \"npm run start\" \"wait-on http://localhost:4200 && cross-env OSUMI_TPV_RENDERER_URL=http://localhost:4200 electron .\"",
    "start:desktop:prod": "npm run build:desktop && electron .",
    "build": "ng build",
    "build:desktop": "npm run build -- --base-href ./ && npm run build:electron",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@osumi/angular-tools": "^1.5.2",
    "@osumi/tools": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "angular-eslint": "22.1.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
