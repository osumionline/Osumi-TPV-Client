{
  "name": "osumi-tpv-client",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "build:electron": "npm run typecheck:electron && node scripts/build-electron.mjs",
    "start:desktop": "npm run build:electron && concurrently -k -n ANGULAR,ELECTRON \"npm run start\" \"wait-on http://localhost:4500 && cross-env OSUMI_TPV_RENDERER_URL=http://localhost:4500 electron .\"",
    "start:desktop:prod": "npm run build:desktop && electron .",
    "build": "ng build",
    "build:desktop": "npm run build -- --base-href ./ && npm run build:electron",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:electron": "set npm_config_allow_scripts=&& node scripts/test-electron.mjs",
    "test:electron:vitest": "vitest run --config electron/vitest.config.mts",
    "lint": "ng lint",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native"
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@osumi/angular-tools": "^1.5.2",
    "@osumi/ticketbaiws": "^1.0.1",
    "angularx-qrcode": "^22.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "ngx-image-cropper": "^9.1.7",
    "nodemailer": "^10.0.14",
    "qrcode-generator": "^2.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "sharp": "^0.35.5",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron-rebuild": true,
    "@electron/rebuild": true
  }
}
